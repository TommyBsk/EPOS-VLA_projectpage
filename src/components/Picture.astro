---
import { Picture as AstroPicture } from "astro:assets";
import { renderPDF } from "../lib/render-pdf";

interface Props {
  src: ImageMetadata | `${string}.pdf`;
  alt: string;
  priority?: boolean;
  invertInDarkMode?: boolean;
}

const { src, alt, priority = false, invertInDarkMode = false } = Astro.props;

let image: ImageMetadata;

if (typeof src === "string") {
  if (src.endsWith(".pdf")) {
    image = await renderPDF(src);
  } else {
    throw new Error(
      `Picture: string src must be a .pdf path (got "${src}"). Import raster images instead: import img from "./assets/foo.png" and pass src={img}.`,
    );
  }
} else {
  image = src;
}
---

<AstroPicture
  class={`rounded-lg max-h-[calc(100svh-3rem)] max-w-full w-min mx-auto ${invertInDarkMode ? "dark:invert" : ""}`}
  src={image}
  alt={alt}
  layout="constrained"
  formats={["avif"]}
  priority={priority}
  fit="contain"
/>
